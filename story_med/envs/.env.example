# DeepEval / Confident AI
CONFIDENT_API_KEY=your_confident_api_key

# 通用运行配置
STORY_MED_TIMEOUT_SECONDS=600
STORY_MED_VERIFY_SSL=true
STORY_MED_ACCEPT=application/json

# 内容中台 / 患者故事 Agent
STORY_MED_ADJUST_BASE_URL=https://your-content-hub-host
STORY_MED_ADJUST_ORIGIN=https://your-frontend-host
STORY_MED_ADJUST_REFERER=https://your-frontend-host/
STORY_MED_ADJUST_ACCEPT=text/event-stream;charset=UTF-8, text/event-stream
STORY_MED_ADJUST_AUTH_USERNAME=your_username
STORY_MED_ADJUST_AUTH_PASSWORD=your_password
STORY_MED_ADJUST_AUTH_TOKEN=Bearer your_runtime_token

# 兼容旧逻辑：如果不显式设置 STORY_MED_ADJUST_AUTH_TOKEN，会回退读取 authorization
authorization=Bearer your_runtime_token

# 文本模型
STORY_MED_LLM_ENABLED=true
STORY_MED_LLM_BASE_URL=https://your-llm-base-url
STORY_MED_LLM_MODEL=your_text_model
STORY_MED_LLM_TIMEOUT_SECONDS=300
STORY_MED_LLM_API_KEY=your_llm_api_key

# 多模态模型
STORY_MED_VISION_ENABLED=true
STORY_MED_VISION_PROVIDER=openai_compatible
STORY_MED_VISION_BASE_URL=https://your-vision-base-url
STORY_MED_VISION_MODEL=your_vision_model
STORY_MED_VISION_TIMEOUT_SECONDS=300
STORY_MED_VISION_NHTAI_SERVICE_NAME=your_nhtai_service_name
STORY_MED_VISION_NHTAI_MODEL_VERSION=latest
STORY_MED_VISION_NHTAI_HOST_HEADER=
STORY_MED_VISION_API_KEY=your_vision_api_key

# 百炼 / OpenAI 兼容链路常用兼容变量
DASHSCOPE_API_KEY=your_dashscope_api_key
OPENAI_BASE_URL=https://your-openai-compatible-base-url
OPENAI_API_KEY=your_openai_api_key
